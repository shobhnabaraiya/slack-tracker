{
  "name": "slack-tracker",
  "version": "4.0.2",
  "description": "A simple Slack logger that sends logs to a Slack channel via a webhook URL",
  "main": "dist/index.js",
  "browser": "dist/browser.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node scripts/build-dist.js",
