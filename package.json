    "logger",
    "slack-webhook",
    "shobhna baraiya"
  ],
  "author": "Shobhna Baraiya",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.6.7"
  }
}
